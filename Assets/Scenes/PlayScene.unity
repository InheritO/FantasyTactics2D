--- !u!114 &918333741
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 918333739}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAC8C\uC784 \uBAA9\uD45C\n\uC815\uD574\uC9C4 \uD3EC\uC778\uD2B8 \uC548\uC5D0\uC11C
    \uBD80\uB300\uB97C \uD3B8\uC131\uD558\uACE0, \uC0C1\uB300 \uC138\uB825\uC744
    \uC804\uBA78\uC2DC\uD0A4\uBA74 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\n\n\uC9C4\uD589
    \uC21C\uC11C\n\n\uBD80\uB300 \uD3B8\uC131 \u2014 \uC885\uC871\uC744 \uACE0\uB974\uACE0,
    \uD3EC\uC778\uD2B8 \uD55C\uB3C4 \uC548\uC5D0\uC11C \uBB34\uAE30\xB7\uBC29\uC5B4\uAD6C\xB7\uBC29\uD328\uB97C
    \uAC16\uCD98 \uC720\uB2DB\uB4E4\uC744 \uCD94\uAC00\uD569\uB2C8\uB2E4.\n\uBC30\uCE58
    \u2014 \uC790\uAE30 \uC9C4\uC601 \uAD6C\uC5ED \uC548\uC5D0 \uC720\uB2DB\uC744
    \uBC30\uCE58\uD569\uB2C8\uB2E4.\n\uC804\uD22C \u2014 \uC138\uB825 \uB2E8\uC704\uB85C
    \uD134\uC774 \uB3CC\uC544\uAC00\uBA70 \uC804\uD22C\uD569\uB2C8\uB2E4.\n\uACB0\uACFC
    \u2014 \uD55C\uCABD \uC138\uB825\uC774 \uC804\uBA78\uD558\uBA74 \uC804\uD22C\uAC00
    \uB05D\uB0A9\uB2C8\uB2E4.\n\n\uC870\uC791\uBC95\n\n\uC88C\uD074\uB9AD \u2014
    \uB0B4 \uC720\uB2DB \uC120\uD0DD / \uC774\uB3D9\uD560 \uD0C0\uC77C \uD074\uB9AD
    / \uC801 \uD074\uB9AD\uD574\uC11C \uACF5\uACA9\nR \u2014 \uC120\uD0DD\uD55C \uC720\uB2DB\uC758
    \uD589\uB3D9 \uD328\uB110(\uBC29\uC5B4\uD0DC\uC138\xB7\uC7AC\uC7A5\uC804 \uB4F1)
    \uC5F4\uAE30\xB7\uB2EB\uAE30\nEsc \u2014 \uC120\uD0DD \uCDE8\uC18C\nWASD \u2014
    \uD654\uBA74 \uC774\uB3D9\n\uB9C8\uC6B0\uC2A4 \uD720 \u2014 \uD654\uBA74 \uD655\uB300\xB7\uCD95\uC18C\n\n\uD134\uACFC
    \uD589\uB3D9\n\n\uC720\uB2DB\uC740 \uC790\uAE30 \uD134\uC5D0 \uC774\uB3D9\uACFC
    \uD589\uB3D9(\uACF5\uACA9 \uB4F1) \uC911 \uD558\uB098\uB9CC \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uD589\uB3D9\uC744 \uD558\uBA74 \uADF8 \uD134\uC5D4 \uB354 \uC774\uC0C1 \uC774\uB3D9\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uC77C\uBD80 \uC885\uC871(\uC5D8\uD504)\uC740
    \uD55C \uD134\uC5D0 \uD589\uB3D9\uC744 \uB450 \uBC88 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC11D\uAD81
    \uB4F1 \uC77C\uBD80 \uBB34\uAE30\uB294 \uBC1C\uC0AC \uD6C4 \uC7AC\uC7A5\uC804\uC774
    \uD544\uC694\uD574, \uB2E4\uC74C \uACF5\uACA9\uAE4C\uC9C0 \uD55C \uD134\uC744
    \uB354 \uC368\uC57C \uD569\uB2C8\uB2E4.\n\uBAA8\uB4E0 \uC720\uB2DB\uC774 \uD589\uB3D9\uC744
    \uB9C8\uCE58\uAC70\uB098 \uD134 \uC885\uB8CC \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
    \uC0C1\uB300 \uD134\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4.\n\n\uC804\uD22C
    \uD310\uC815 \uC21C\uC11C\n\uACF5\uACA9\uC740 \uD56D\uC0C1 \uC774 \uC21C\uC11C\uB85C
    \uC815\uD574\uC9D1\uB2C8\uB2E4.\n\n\uBA85\uC911/\uD68C\uD53C \u2014 \uACF5\uACA9\uC790\uC640
    \uBC29\uC5B4\uC790\uC758 \uBBFC\uCCA9\uC744 \uBE44\uAD50\n\uB9C9\uAE30 \u2014
    \uBC29\uD328\uAC00 \uC788\uC73C\uBA74 \uB9C9\uAE30\uB97C \uC2DC\uB3C4, \uC131\uACF5\uD558\uBA74
    \uD53C\uD574 \uC5C6\uC74C\n\uD53C\uD574 \u2014 \uBB34\uAE30 \uC704\uB825\uC5D0\uC11C
    \uBC29\uC5B4\uB825\uC744 \uBE80 \uB9CC\uD07C \uD53C\uD574\n\uCE58\uBA85\uD0C0
    \u2014 \uB9C9\uAE30\uC5D0 \uC2E4\uD328\uD588\uB2E4\uBA74 \uB0AE\uC740 \uD655\uB960\uB85C
    1.5\uBC30 \uD53C\uD574\n\uC0C1\uD0DC\uC774\uC0C1 \u2014 \uBB34\uAE30\uC5D0 \uB530\uB77C
    \uCD9C\uD608\xB7\uAE30\uC808\xB7\uBC29\uC5B4\uAD6C \uD30C\uAD34 \uB4F1\uC774
    \uAC78\uB9B4 \uC218 \uC788\uC74C\n\n\uC804\uC220 \uC694\uC18C\n\n\uBC18\uACA9
    \u2014 \uC77C\uBD80 \uBB34\uAE30(\uAC80\uB958)\uB294 \uADFC\uC811 \uC0AC\uAC70\uB9AC
    \uC548\uC5D0\uC11C \uACF5\uACA9\uBC1B\uC73C\uBA74 \uC790\uB3D9\uC73C\uB85C \uBC18\uACA9\uD569\uB2C8\uB2E4.\n\uAE30\uD68C\uACF5\uACA9
    \u2014 \uC801\uACFC \uBD99\uC5B4\uC788\uB2E4\uAC00 \uADF8 \uC801\uC5D0\uAC8C\uC11C
    \uBA40\uC5B4\uC9C0\uB294 \uC774\uB3D9\uC744 \uD558\uBA74, \uBC97\uC5B4\uB098\uB294
    \uC21C\uAC04 \uACF5\uC9DC\uB85C \uD55C \uB300 \uB9DE\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC5C4\uD3D0
    \u2014 \uC7A5\uC560\uBB3C \uC606\uC5D0 \uC788\uC73C\uBA74 \uC6D0\uAC70\uB9AC
    \uACF5\uACA9\uC5D0 \uB9DE\uC744 \uD655\uB960\uC774 \uB0AE\uC544\uC9D1\uB2C8\uB2E4.\n\uBC29\uC5B4\uD0DC\uC138
    \u2014 \uC774\uBC88 \uD134\uC5D0 \uB9C9\uAE30 \uD655\uB960\uC744 \uD06C\uAC8C
    \uC62C\uB824\uC8FC\uB294 \uB300\uC2E0, \uD589\uB3D9\uB825\uC744 \uC18C\uBAA8\uD569\uB2C8\uB2E4."
  m_isRightToLeft: 0
